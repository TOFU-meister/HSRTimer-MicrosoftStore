<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>HSRTimer</AssemblyName>
    <Product>HSRTimer</Product>
    <Version>0.0.0</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HSRTimer</RootNamespace>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <RestoreSources></RestoreSources>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StoreIl2Cpp)' == 'true'">
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <NoStdLib>false</NoStdLib>
    <DisableImplicitFrameworkReferences>false</DisableImplicitFrameworkReferences>
    <DefineConstants>$(DefineConstants);STORE_IL2CPP</DefineConstants>
    <Version>0.1.1-pre</Version>
    <StorePreview Condition="'$(StorePreview)' == ''">false</StorePreview>
    <DefineConstants Condition="'$(StorePreview)' == 'true'">$(DefineConstants);STORE_PREVIEW</DefineConstants>
    <OutputPath>bin/store/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(StoreIl2Cpp)' == 'true'">
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <StoreCore Include="BepInEx.Core;BepInEx.Unity.IL2CPP;Il2CppInterop.Runtime;0Harmony" />
    <StoreInterop Include="Il2Cppmscorlib;Il2CppSystem;Assembly-CSharp;HumanAPI;UnityEngine.CoreModule;UnityEngine.IMGUIModule;UnityEngine.TextRenderingModule;UnityEngine.AudioModule;UnityEngine.PhysicsModule;UnityEngine.InputLegacyModule;UnityEngine.UnityWebRequestModule;UnityEngine.UI" />
    <Reference Include="@(StoreCore->'$(BepInExDir)/core/%(Identity).dll')" Private="false" />
    <Reference Include="@(StoreInterop->'$(BepInExDir)/interop/%(Identity).dll')" Private="false" />
  </ItemGroup>

  <Target Name="CheckStoreReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(StoreIl2Cpp)' == 'true'">
    <Error Condition="'$(BepInExDir)' == ''" Text="Set BepInExDir to the Microsoft Store game's BepInEx folder (containing core and generated interop)." />
    <Error Condition="!Exists('$(BepInExDir)/core/%(StoreCore.Identity).dll')" Text="Missing core/%(StoreCore.Identity).dll in $(BepInExDir)." />
    <Error Condition="!Exists('$(BepInExDir)/interop/%(StoreInterop.Identity).dll')" Text="Missing generated interop/%(StoreInterop.Identity).dll in $(BepInExDir)." />
  </Target>

  <!-- Base class libraries from Unity Mono (net35-equivalent) -->
  <ItemGroup Condition="'$(StoreIl2Cpp)' != 'true'">
    <Reference Include="mscorlib">
      <HintPath>$(GAME_MANAGED)/mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(GAME_MANAGED)/System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(GAME_MANAGED)/System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Xml">
      <HintPath>$(GAME_MANAGED)/System.Xml.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx & Harmony -->
  <ItemGroup Condition="'$(StoreIl2Cpp)' != 'true'">
    <Reference Include="BepInEx">
      <HintPath>$(BEPINEX_CORE)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(BEPINEX_CORE)/BepInEx.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BEPINEX_CORE)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assemblies -->
  <ItemGroup Condition="'$(StoreIl2Cpp)' != 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GAME_MANAGED)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HumanAPI">
      <HintPath>$(GAME_MANAGED)/HumanAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity engine modules (only what HSRTimer uses) -->
  <ItemGroup Condition="'$(StoreIl2Cpp)' != 'true'">
    <Reference Include="UnityEngine">
      <HintPath>$(GAME_MANAGED)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Ship default language files alongside the DLL -->
  <ItemGroup>
    <None Include="lang\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Embed the authoritative English base + example translation so the
       plugin always has working localization even if the lang/ folder is not
       copied next to the DLL. Disk lang/*.txt files override these. -->
  <ItemGroup>
    <EmbeddedResource Include="lang\en.txt">
      <LogicalName>HSRTimer.lang.en.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="lang\zh-Hans.txt">
      <LogicalName>HSRTimer.lang.zh-Hans.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Keep the assembly identity as HSRTimer for external plugin
       compatibility, but also emit a versioned filename for releases. -->
  <Target Name="CopyVersionedDll" AfterTargets="Build" Condition="'$(StoreIl2Cpp)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)HSRTimer-v$(Version).dll" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFiles="$(TargetDir)HSRTimer-v$(Version).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
  </Target>

</Project>
